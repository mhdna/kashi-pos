# Copy this file to .env. Explicit process environment variables take precedence.

# General application settings
KASHI_BRANCH_NAME=Main
# Short branch code; letters and numbers are accepted.
# Also used to derive this instance's default local database directory
# (".../kashi-pos/database-<code>"), so each branch's .env keeps its own
# local state even when multiple instances run on the same machine.
KASHI_BRANCH_CODE=CN
KASHI_API_KEY=
# Application-specific printer/device identifiers; leave empty when unused.
KASHI_PRINTER_ID=
KASHI_PRINTER_SIZE=
# Windows printer name, or CUPS printer name on macOS/Linux.
KASHI_RECEIPT_PRINTER=
# Customer-display serial port, for example COM3 or /dev/ttyUSB0.
KASHI_SCREEN_PORT=
# Allowed: light, dark, system.
KASHI_THEME=light
# Decimal fraction, so 15% is written as 0.15.
KASHI_TAX_RATE=0
# Allowed: half_up, down, up.
KASHI_ROUNDING_MODE=half_up
# Allowed: true or false.
KASHI_RECEIPT_ENABLED=false
# Existing inventory ID; 0 means no inventory is selected.
KASHI_SALES_INVENTORY_ID=0
# Positive integer exchange rate, for example 90000.
KASHI_EXCHANGE_RATE=90000

# Receipt branding and printing
KASHI_MARKET_NAME=Main
KASHI_MARKET_PHONE=
KASHI_BRANCH_PHONE=
KASHI_MARKET_DESCRIPTION=Shop for all
KASHI_RETURN_POLICY=
KASHI_WEBSITE=
KASHI_INSTAGRAM=
KASHI_COUNTER_NUMBER=
# Allowed platforms: facebook, tiktok, instagram, threads, youtube.
# Use JSON or comma-separated values, for example: facebook,instagram,youtube
KASHI_SOCIAL_PLATFORMS=[]
# JSON object keyed by platform, for example: {"facebook":"@kashi","youtube":"Kashi Market"}
KASHI_SOCIAL_HANDLES={}
# Allowed: Belleza, Helvetica, Times, Courier.
KASHI_RECEIPT_FONT=Belleza
# Allowed: Printer Font A, Courier, Helvetica, Times, Belleza.
KASHI_RECEIPT_BODY_FONT=Printer Font A
# Market name size: 8 through 40.
KASHI_RECEIPT_TITLE_SIZE=21
# Body size: 6 through 24.
KASHI_RECEIPT_BODY_SIZE=11
# Allowed: true or false.
KASHI_RECEIPT_CUTOFF=true
# Use 80 for 80mm paper or 58 for 58mm paper.
KASHI_RECEIPT_WIDTH=80
# Page height in millimeters; raster printing crops to receipt content.
KASHI_RECEIPT_HEIGHT=297
