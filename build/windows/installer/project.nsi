Unicode true

####
## Custom Kashi Cloud installer, based on the Wails NSIS template.
##
## This installs AND upgrades cleanly:
##  - if a previous version is already installed, its running process is
##    closed and its files are overwritten in place (same install dir,
##    same registry key), so Explorer shortcuts and the uninstall entry
##    keep working across versions.
##  - user data (the local database, settings, etc.) lives outside
##    $INSTDIR (in %AppData%), so upgrading never touches it.
##
## "wails_tools.nsh" is regenerated by `wails build --nsis` every time and
## fills in INFO_* from wails.json's "info" block. Do not edit that file;
## override values here instead (see the wails template's own comment
## block for the full list of overridable defines).
##
## To build the installer:
##   wails build -platform windows/amd64 -nsis -clean
## (requires NSIS's makensis on PATH, e.g. `brew install makensis` on macOS)
####

# Keep this in sync with wails.json's "outputfilename" - the wails.files
# macro copies whatever binary was built and renames it to this, so if this
# doesn't match, shortcuts/taskkill/uninstall all silently target the wrong
# file.
!define PRODUCT_EXECUTABLE "Kashi-Cloud.exe"

# Stable across renames of company/product name in wails.json, so upgrades
# from older installs (built before this file existed) still find the same
# registry key and uninstall entry instead of leaving a duplicate behind.
!define UNINST_KEY_NAME "Kashikashicloud"

!include "wails_tools.nsh"

# The version information for this two must consist of 4 parts. The
# Makefile's set-version stamps wails.json with a 4-part version already.
VIProductVersion "${INFO_PRODUCTVERSION}"
VIFileVersion    "${INFO_PRODUCTVERSION}"

VIAddVersionKey "CompanyName"     "${INFO_COMPANYNAME}"
VIAddVersionKey "FileDescription" "${INFO_PRODUCTNAME} Installer"
VIAddVersionKey "ProductVersion"  "${INFO_PRODUCTVERSION}"
VIAddVersionKey "FileVersion"     "${INFO_PRODUCTVERSION}"
VIAddVersionKey "LegalCopyright"  "${INFO_COPYRIGHT}"
VIAddVersionKey "ProductName"     "${INFO_PRODUCTNAME}"

# Enable HiDPI support. https://nsis.sourceforge.io/Reference/ManifestDPIAware
ManifestDPIAware true

!include "MUI.nsh"
!include "LogicLib.nsh"

!define MUI_ICON "..\icon.ico"
!define MUI_UNICON "..\icon.ico"
!define MUI_FINISHPAGE_NOAUTOCLOSE # Wait on the INSTFILES page so the user can take a look into the details of the installation steps
!define MUI_ABORTWARNING # This will warn the user if they exit from the installer.
!define MUI_FINISHPAGE_RUN "$INSTDIR\${PRODUCT_EXECUTABLE}" # Offer to launch the app when the installer finishes.

!insertmacro MUI_PAGE_WELCOME # Welcome to the installer page.
!insertmacro MUI_PAGE_DIRECTORY # In which folder install page.
!insertmacro MUI_PAGE_INSTFILES # Installing page.
!insertmacro MUI_PAGE_FINISH # Finished installation page.

!insertmacro MUI_UNPAGE_CONFIRM # Are you sure you want to uninstall page.
!insertmacro MUI_UNPAGE_INSTFILES # Uninstalling page.

!insertmacro MUI_LANGUAGE "English" # Set the Language of the installer

## The following two statements can be used to sign the installer and the uninstaller. The path to the binaries are provided in %1
#!uninstfinalize 'signtool --file "%1"'
#!finalize 'signtool --file "%1"'

Name "${INFO_PRODUCTNAME}"
OutFile "..\..\bin\${INFO_PROJECTNAME}-${ARCH}-installer.exe" # Name of the installer's file.
InstallDir "$PROGRAMFILES64\${INFO_COMPANYNAME}\${INFO_PRODUCTNAME}" # Default installing folder ($PROGRAMFILES is Program Files folder).
ShowInstDetails show # This will always show the installation details.

# Populated in .onInit when an existing install is found, so the rest of
# the script (install dir default, welcome text, uninstall-before-install)
# can branch on it.
Var IsUpgrade
Var OldVersion

Function .onInit
   !insertmacro wails.checkArchitecture

   StrCpy $IsUpgrade "0"

   SetRegView 64
   ReadRegStr $OldVersion HKLM "${UNINST_KEY}" "DisplayVersion"
   ${If} $OldVersion != ""
       StrCpy $IsUpgrade "1"

       # Reuse the directory the previous version was installed to, so
       # upgrades land in the same place instead of silently creating a
       # second copy under the default path.
       ReadRegStr $R0 HKLM "${UNINST_KEY}" "InstallLocation"
       ${If} $R0 != ""
           StrCpy $INSTDIR $R0
       ${EndIf}

       ${IfNot} ${Silent}
           MessageBox MB_YESNO|MB_ICONQUESTION \
               "${INFO_PRODUCTNAME} $OldVersion is already installed.$\r$\n$\r$\nContinue to upgrade to ${INFO_PRODUCTVERSION}?" \
               IDYES upgrade_confirmed
           Abort
           upgrade_confirmed:
       ${EndIf}
   ${EndIf}
FunctionEnd

# Best-effort close of a running instance so its files aren't locked when
# we overwrite them. Not fatal if nothing is running or taskkill can't find
# it - installation proceeds either way.
!macro CLOSE_RUNNING_APP
    DetailPrint "Closing ${INFO_PRODUCTNAME} if it is running..."
    nsExec::ExecToLog 'taskkill /F /IM "${PRODUCT_EXECUTABLE}"'
    Pop $0
    Sleep 500
!macroend

Section
    !insertmacro wails.setShellContext

    !insertmacro CLOSE_RUNNING_APP

    !insertmacro wails.webview2runtime

    SetOutPath $INSTDIR

    !insertmacro wails.files

    CreateShortcut "$SMPROGRAMS\${INFO_PRODUCTNAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"
    CreateShortCut "$DESKTOP\${INFO_PRODUCTNAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"

    !insertmacro wails.associateFiles
    !insertmacro wails.associateCustomProtocols

    !insertmacro wails.writeUninstaller

    # wails.writeUninstaller doesn't record where it installed to; add it
    # so the next upgrade (see .onInit above) can find this directory.
    SetRegView 64
    WriteRegStr HKLM "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
SectionEnd

Section "uninstall"
    !insertmacro wails.setShellContext

    !insertmacro CLOSE_RUNNING_APP

    RMDir /r "$AppData\${PRODUCT_EXECUTABLE}" # Remove the WebView2 DataPath

    RMDir /r $INSTDIR

    Delete "$SMPROGRAMS\${INFO_PRODUCTNAME}.lnk"
    Delete "$DESKTOP\${INFO_PRODUCTNAME}.lnk"

    !insertmacro wails.unassociateFiles
    !insertmacro wails.unassociateCustomProtocols

    !insertmacro wails.deleteUninstaller
SectionEnd
